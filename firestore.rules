rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bookings/{bookingId} {
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "Pending Confirmation";
      allow get: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || request.auth.token.email == "PASTE_ADMIN_EMAIL");
      allow list: if request.auth != null
        && request.auth.token.email == "PASTE_ADMIN_EMAIL";
      allow update: if request.auth != null && (
        request.auth.token.email == "PASTE_ADMIN_EMAIL"
        || (
          resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.status == "Cancelled"
          && resource.data.status in ["Pending Confirmation", "Accepted"]
          && resource.data.scheduledAt > request.time.toMillis() + 7200000
        )
      );
      allow delete: if false;
    }
    match /bookingStatus/{bookingId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.token.email == "PASTE_ADMIN_EMAIL";
      allow delete: if false;
    }
  }
}